<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebuggerFlavor>LaunchJsonDebugger</DebuggerFlavor>
    <LaunchJsonTarget>{
  "name": "Attach to rejkid.api (port 9222)",
  "type": "chrome",
  "request": "attach",
  "url": "https://rejkid.api:4200/*",
  "webRoot": "C:\\Workspace\\ScheduleMeSolution\\scheduleme.client",
  "port": 9222,
  "sourceMapPathOverrides": {
    "https://rejkid.api:4200/src/*": "C:\\Workspace\\ScheduleMeSolution\\scheduleme.client\\src\\*",
    "/src/*": "C:\\Workspace\\ScheduleMeSolution\\scheduleme.client\\src\\*",
    "src/*": "C:\\Workspace\\ScheduleMeSolution\\scheduleme.client\\src\\*"
  }
}</LaunchJsonTarget>
  </PropertyGroup>
</Project>